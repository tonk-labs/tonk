+                let lost = message.contains("Version mismatch") || message.contains("Lock error");
+                if !lost || attempt >= policy.tries() {
+                    return Err(EvalError::Io(format!("commit failed: {message}")));
+                }
+                if policy == Policy::Hybrid {
+                    escalated = true;
+                }
+                if policy == Policy::Backoff {
+                    let base = 1u64 << attempt.min(6);
+                    let jitter = std::time::SystemTime::now()
+                        .duration_since(std::time::UNIX_EPOCH)
+                        .map(|d| u64::from(d.subsec_nanos()) % base.max(1))
+                        .unwrap_or(0);
+                    tokio::time::sleep(std::time::Duration::from_millis(base + jitter)).await;
+                }
+            }
+        }
     };
+    if attempt > 1 {
+        eprintln!("eval: committed on attempt {attempt}");
+    }
 
     let stdout = output::render(&response, options.format, options.quiet)
         .map_err(|e| EvalError::Io(format!("output rendering failed: {e}")))?;
@@ -417,3 +456,53 @@ fn map_evaluate_error(error: EvaluateError) -> EvalError {
         EvaluateError::Query(message) => EvalError::Commit(message),
     }
 }
+
+/// Experiment only: how an eval that lost its race is handled, from
+/// `TONK_EVAL_POLICY`.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Policy {
+    /// One try (main).
+    Once,
+    /// Evaluate again over the new head at once, up to 64 tries.
+    Retry,
+    /// As `Retry`, after a jittered exponential pause (2-128 ms).
+    Backoff,
+    /// Every eval holds the space's eval lock from read to publish.
+    Queue,
+    /// Optimistic first, publishing under the lock; after one loss, queued.
+    Hybrid,
+}
+
+impl Policy {
+    fn from_env() -> Self {
+        match std::env::var("TONK_EVAL_POLICY").as_deref() {
+            Ok("retry") => Self::Retry,
+            Ok("backoff") => Self::Backoff,
+            Ok("queue") => Self::Queue,
+            Ok("hybrid") => Self::Hybrid,
+            _ => Self::Once,
+        }
+    }
+
+    fn tries(self) -> u32 {
+        match self {
+            Self::Once => 1,
+            Self::Hybrid => 2,
+            Self::Queue => 3,
+            Self::Retry | Self::Backoff => 64,
+        }
+    }
+}
+
+/// Take the space's eval lock, waiting for it.
+fn lock(path: &std::path::Path) -> Result<std::fs::File, EvalError> {
+    let file = std::fs::OpenOptions::new()
+        .create(true)
+        .truncate(false)
+        .write(true)
+        .open(path)
+        .map_err(|e| EvalError::Io(format!("open eval lock: {e}")))?;
+    file.lock()
+        .map_err(|e| EvalError::Io(format!("take eval lock: {e}")))?;
+    Ok(file)
+}
