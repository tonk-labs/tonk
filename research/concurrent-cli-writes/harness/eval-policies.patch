+/// Experiment only: an eval's entry in the space's age registry, a file
+/// named by its start time and pid, removed when the eval ends.
+struct Age {
+    dir: std::path::PathBuf,
+    name: String,
+}
+
+impl Age {
+    fn register(dir: &std::path::Path) -> Result<Self, EvalError> {
+        std::fs::create_dir_all(dir).map_err(|e| EvalError::Io(format!("age registry: {e}")))?;
+        let started = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_nanos())
+            .unwrap_or(0);
+        let name = format!("{started:024}-{:010}", std::process::id());
+        std::fs::write(dir.join(&name), b"")
+            .map_err(|e| EvalError::Io(format!("age registry: {e}")))?;
+        Ok(Self {
+            dir: dir.to_owned(),
+            name,
+        })
+    }
+
+    /// Whether an eval that started before this one is still running.
+    fn older_in_flight(&self) -> bool {
+        let Ok(entries) = std::fs::read_dir(&self.dir) else {
+            return false;
+        };
+        entries.flatten().any(|entry| {
+            let name = entry.file_name().to_string_lossy().into_owned();
+            if name >= self.name {
+                return false;
+            }
+            let alive = name
+                .rsplit('-')
+                .next()
+                .and_then(|pid| pid.parse::<u32>().ok())
+                .is_some_and(|pid| std::path::Path::new(&format!("/proc/{pid}")).exists());
+            if !alive {
+                let _ = std::fs::remove_file(entry.path());
+            }
+            alive
+        })
+    }
+
+    /// Defer while an older eval is in flight, for at most five seconds.
+    async fn wait_for_older(&self) {
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+        while self.older_in_flight() && std::time::Instant::now() < deadline {
+            tokio::time::sleep(std::time::Duration::from_millis(1)).await;
+        }
+    }
+}
+
+impl Drop for Age {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(self.dir.join(&self.name));
+    }
+}
