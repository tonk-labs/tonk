+        let published = txn.commit().publish().perform(&site.operator).await;
+        match published {
+            Ok(revision_after) => {
+                session.state.stack().schedule_poll();
+                break (
+                    EvaluateResponse {
+                        revision_before,
+                        revision_after: Some(revision_after),
+                        matches_before,
