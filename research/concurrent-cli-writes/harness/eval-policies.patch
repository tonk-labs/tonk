+    // Experiment only: TONK_RECONCILE=a,b,... pulls each named branch into
+    // main, over and over, until the file TONK_RECONCILE_STOP exists, then
+    // once more. Prints one line per pass that moved main.
+    if let Ok(names) = std::env::var("TONK_RECONCILE") {
+        let stop = std::env::var("TONK_RECONCILE_STOP").unwrap_or_default();
+        let main = match site.branch().await {
+            Ok(session) => session,
+            Err(e) => return print_error(format!("acquire main: {e}")),
+        };
+        let names: Vec<String> = names.split(',').map(str::to_owned).collect();
+        let mut last = false;
+        loop {
+            if !last && std::path::Path::new(&stop).exists() {
+                last = true;
+            }
+            let started = std::time::Instant::now();
+            let mut moved = 0;
+            for name in &names {
+                let writer = match site
+                    .reactor
+                    .repository(tonk_cli::site::REPO_NAME)
+                    .branch(name)
+                    .acquire(&site.operator)
+                    .await
+                {
+                    Ok(writer) => writer,
+                    Err(e) => {
+                        eprintln!("reconcile\terror\t{name}\tacquire: {e}");
+                        continue;
+                    }
+                };
+                let _ = writer.handle().refresh(&site.operator).await;
+                let _ = main.handle().refresh(&site.operator).await;
+                match main
+                    .handle()
+                    .pull(dialog_repository::Download::MinimalRanges)
+                    .from(writer.handle())
+                    .perform(&site.operator)
+                    .await
+                {
+                    Ok(Some(_)) => moved += 1,
+                    Ok(None) => {}
+                    Err(e) => eprintln!("reconcile\terror\t{name}\t{e}"),
+                }
+            }
+            if moved > 0 {
+                eprintln!("reconcile\tpass\t{moved}\t{}", started.elapsed().as_micros());
+            }
+            if last {
+                return ExitCode::Success;
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(5)).await;
+        }
+    }
     // Experiment only: TONK_EVAL_WARM=k commits the inline document k more
