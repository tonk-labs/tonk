{
  "name": "@tonk/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test *.test.mjs",
    "pretest": "npm run check:generated",
    "build:guides": "node scripts/build-authoring-guides.mjs",
    "check:generated": "node scripts/build-authoring-guides.mjs --check",
    "format": "npm exec --yes --package=prettier@3.6.2 -- prettier --write \"*.mjs\" \"scripts/*.mjs\" \"integration/*.mjs\" \"tools.json\" \"hosted/*.mjs\" \"hosted/cloudflare/*.mjs\" \"apps/*.mjs\" \"apps/ui/*.{js,html}\" \"chatgpt/*.mjs\"",
    "check:format": "npm exec --yes --package=prettier@3.6.2 -- prettier --check \"*.mjs\" \"scripts/*.mjs\" \"integration/*.mjs\" \"tools.json\" \"hosted/*.mjs\" \"hosted/cloudflare/*.mjs\" \"apps/*.mjs\" \"apps/ui/*.{js,html}\" \"chatgpt/*.mjs\"",
    "test:integration": "npm run check:generated && node --test integration/*.test.mjs",
    "test:chatgpt": "npm run test:hosted && npm run test:apps",
    "start:chatgpt": "npm run start:hosted",
    "build:chatgpt-assets": "npm run build:hosted-assets",
    "test:hosted": "node --test hosted/*.test.mjs hosted/cloudflare/*.test.mjs",
    "test:apps": "node --test apps/*.test.mjs chatgpt/*.test.mjs",
    "start:hosted": "node hosted/server.mjs",
    "build:hosted-assets": "node hosted/build-assets.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "esbuild": "0.24.2"
  }
}
