+/// Immutable invocation and exact proof path, available only after verification.
+/// Unreferenced container blocks are deliberately not exposed.
+pub struct VerifiedInvocation {
+    chain: InvocationChain<dialog_varsig::AnySignature>,
+    range: TimeRange,
+}
+
+impl VerifiedInvocation {
+    /// Root subject whose authority was verified.
+    pub fn subject(&self) -> &Did {
+        self.chain.subject()
+    }
+    /// Invoking principal.
+    pub fn issuer(&self) -> &Did {
+        self.chain.issuer()
+    }
+    /// Signed invocation audience; embedders must check their service binding.
+    pub fn audience(&self) -> &Did {
+        self.chain.invocation.audience()
+    }
+    /// Verified command.
+    pub fn command(&self) -> &dialog_ucan_core::command::Command {
+        self.chain.command()
+    }
+    /// Signed invocation arguments.
+    pub fn arguments(&self) -> &Args {
+        self.chain.arguments()
+    }
+    /// Verified delegation CIDs, in root-to-leaf order.
+    pub fn proofs(&self) -> &[ipld_core::cid::Cid] {
+        self.chain.proofs()
+    }
+    /// A delegation on the verified path, never an unrelated container block.
+    pub fn delegation(
+        &self,
+        cid: &ipld_core::cid::Cid,
+    ) -> Option<&dialog_ucan_core::Delegation<dialog_varsig::AnySignature>> {
+        self.proofs()
+            .contains(cid)
+            .then(|| self.chain.delegation(cid).map(AsRef::as_ref))
+            .flatten()
+    }
+    /// Effective intersection of invocation and ancestor validity windows.
+    pub fn time_range(&self) -> TimeRange {
+        self.range
+    }
+}
+
+fn clamp_request(
+    request: &mut dialog_remote_s3::request::S3Request,
+    range: TimeRange,
+    deadline: Option<Timestamp>,
+    now: Timestamp,
+) -> Result<(), S3Error> {
+    range.check(&now).map_err(|error| {
+        S3Error::Authorization(check_failed_to_authorize_error(CheckFailed::TimeBound(
+            error,
+        )))
+    })?;
+    let at = now.to_unix();
+    let mut end = at.saturating_add(60);
+    if let Bound::Included(exp) | Bound::Excluded(exp) = range.expiration {
+        end = end.min(exp.to_unix());
+    }
+    if let Some(deadline) = deadline {
+        end = end.min(deadline.to_unix());
+    }
+    let remaining = end.saturating_sub(at);
+    if remaining == 0 {
+        return Err(S3Error::Authorization(AuthorizeError::Expired {
+            expiration: end,
+            at,
+        }));
+    }
+    request.time = chrono::DateTime::from_timestamp(
+        i64::try_from(at)
+            .map_err(|_| S3Error::Configuration("Signing time is out of range".into()))?,
+        0,
+    )
+    .ok_or_else(|| S3Error::Configuration("Signing time is out of range".into()))?;
+    request.expires = request.expires.min(remaining);
+    Ok(())
+}
 
