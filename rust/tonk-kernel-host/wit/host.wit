package sapling:kernel@0.1.0;

/// The interfaces of `sapling:kernel/kernel` that are Sapling's own: what a
/// host binds with generated code. WASI is defined beside them, dynamically.
world host {
  import types;
  import storage;
  import credential;
  import session;
  import authentication;
  import application;
  import network;
  export lifecycle;
  export channel;
}

/// What a host reaches of a guest kernel built for `persona`, beside what
/// `host` binds: the delegations it grants. A host acquires it only from a
/// kernel that exports it.
world persona-grant {
  export grant;
}
