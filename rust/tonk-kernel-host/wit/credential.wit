package sapling:kernel@0.1.0;

/// The keys the embedder holds, which a guest kernel reaches only through
/// handles: the credential of its session, the representative it acts
/// through, the persona it acts for, and any key it generates.
///
/// - A representative, such as a device, acts for a persona through the
///   persona's delegation to it, and every worker acts through one.
/// - A persona's key is lent to a guest kernel only for one call of the
///   lifecycle (`lifecycle.authorize`, `lifecycle.merge`), as a
///   `persona-authority`, after the embedder opens it with a recovery such
///   as a passkey.
/// - A message, the guest kernel's own bytes, is concealed to any DID, and
///   the credential behind it reveals it.
/// - A key is backed up to a custodian whose key the embedder holds, and the
///   custodian restores it as a credential. Its seed never reaches the guest
///   kernel, so a custodian is a handle and never a DID.
///
/// Concealing takes a context, which the embedder binds into the key it
/// conceals with: a secret reveals only in the context it was concealed in.
/// Backing up takes none: the embedder backs up every key in a context of its
/// own, which no secret can be concealed in, so `reveal` never opens a
/// backup.
interface credential {
  use types.{did, ucan, error};

  /// What a credential signs. Open-ended while we learn what kernels sign;
  /// a narrower variant can be added later.
  variant payload {
    /// The bytes the signature covers, as the guest kernel wrote them.
    bytes(list<u8>),
  }

  /// What a delegation grants, as a guest kernel asks for it.
  record access {
    subject: did,
    /// The command, such as `/blob/put`.
    command: string,
    /// What the delegation must allow, by the name of each argument of the
    /// command, as in the policy of a UCAN.
    arguments: list<argument>,
    /// Why the guest kernel asks, in words the embedder can show a person.
    reason: string,
  }

  /// How a recovery shows the account it recovers, as a passkey does.
  record recovery {
    /// What it shows the account as, such as an email.
    name: string,
    /// A friendlier name for the account, such as a person's name.
    label: option<string>,
  }

  /// One argument of `access`. The value is DAG-CBOR.
  record argument {
    key: string,
    value: list<u8>,
  }

  /// A message, concealed to a DID. The guest kernel stores it and hands it
  /// back to the credential behind that DID to reveal the message.
  type secret = list<u8>;

  /// A key, backed up to a custodian. The guest kernel stores it, by the
  /// custodian's DID, and hands it back to the custodian to restore the key.
  record credential-backup {
    custodian: did,
    secret: list<u8>,
  }

  /// Whom a key is backed up to, or a secret confided to.
  variant custodian {
    credential(borrow<credential>),
    representative(borrow<representative>),
    provisional(borrow<provisional-persona>),
    permanent(borrow<permanent-persona>),
    persona(borrow<persona-authority>),
  }

  /// A new key, made and held by the embedder.
  generate: async func() -> result<credential, error>;
  /// A key from a seed the guest kernel holds. The guest kernel knows its
  /// seed, so the embedder refuses it as a custodian.
  %import: async func(seed: list<u8>) -> result<credential, error>;
  /// `message`, concealed to `to` in `context`.
  conceal: async func(to: did, context: list<u8>, message: list<u8>) -> result<secret, error>;

  /// A key the embedder holds.
  resource credential {
    did: func() -> did;
    /// `payload`, written and signed: the signature over its bytes.
    sign: async func(payload: payload) -> result<list<u8>, error>;
    /// The message `secret` conceals, if it is concealed to this credential
    /// in `context`.
    reveal: async func(context: list<u8>, secret: secret) -> result<list<u8>, error>;
    /// Creates a backup of this key that can be restored by a given `custodian`.
    backup: async func(custodian: custodian) -> result<credential-backup, error>;
    /// Restores credentials from the key backup created for this custodian.
    restore: async func(backup: credential-backup) -> result<credential, error>;
    /// The key this credential derives in `context` for `label`, held by the
    /// embedder too. The same credential derives the same key each time, as
    /// Dialog DB derives a peer's session key from the peer's.
    derive: async func(context: list<u8>, label: list<u8>) -> result<credential, error>;
  }

  /// A person's persona: provisional until the person makes themselves
  /// known, and permanent after.
  variant persona {
    provisional(provisional-persona),
    permanent(permanent-persona),
  }

  /// The persona of a worker no person has made themselves known to. Its key
  /// is the embedder's own.
  resource provisional-persona {
    did: func() -> did;
    /// Ask to merge this persona into the permanent persona `id` names, such
    /// as by an email, once the person signs in with a passkey. The embedder
    /// signs them up when they have no persona. It answers with
    /// `lifecycle.merge`, or not at all when the person declines.
    merge: func(id: string);
  }

  /// The persona of a person who made themselves known. Its key is backed up
  /// to their recoveries, such as passkeys, and the embedder opens it only
  /// for one call of the lifecycle at a time.
  resource permanent-persona {
    did: func() -> did;
    /// Ask to act as this persona. The embedder shows the person `reason`,
    /// opens the persona's key with one of their recoveries, and answers
    /// with `lifecycle.authorize`, passing `context` back, or not at all
    /// when the person declines.
    authorize: func(reason: string, context: list<u8>);
  }

  /// A persona's key, lent to a guest kernel for one call of the lifecycle.
  /// It is gone when that call returns.
  resource persona-authority {
    did: func() -> did;
    /// A delegation of `access` from this persona to `audience`, such as a
    /// representative it links.
    delegate: async func(audience: did, access: access) -> result<ucan, error>;
    /// `secret`, concealed to this persona in `context`, confided to `to`
    /// instead.
    confide: async func(context: list<u8>, secret: secret, to: custodian)
      -> result<secret, error>;
    /// Restores credentials from the key backup created for this persona.
    restore: async func(backup: credential-backup) -> result<credential, error>;
    /// Set up another way to recover this persona on any device, such as a
    /// passkey, kept by the embedder. `recovery` is how it shows the
    /// persona, which is what groups the recoveries of one persona in a
    /// passkey manager. Answers this persona's key backed up to the new
    /// recovery, for the guest kernel to keep where the recovery finds it.
    add-recovery: async func(recovery: recovery) -> result<credential-backup, error>;
    /// Revoke this persona's delegation to the representative `representative`.
    unlink: async func(representative: did) -> result<_, error>;
  }

  /// What a worker acts through, such as a device: a key the embedder holds,
  /// which acts for a persona through the persona's delegation to it, and
  /// signs the delegations to the worker's sessions.
  resource representative {
    did: func() -> did;
    /// The chain of delegations down to `audience` that grants `access`:
    /// from the persona, through this representative, which signs the last
    /// hop. The embedder may ask the person, or ask the persona's guest
    /// kernel (see `guest`), and may refuse.
    delegate: async func(audience: did, access: access) -> result<ucan, error>;
    /// `secret`, concealed to this representative in `context`, confided to
    /// `to` instead.
    confide: async func(context: list<u8>, secret: secret, to: custodian)
      -> result<secret, error>;
    /// Restores credentials from the key backup created for this
    /// representative.
    restore: async func(backup: credential-backup) -> result<credential, error>;
  }
}
