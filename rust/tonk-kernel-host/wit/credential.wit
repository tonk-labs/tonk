package sapling:kernel@0.1.0;

/// The keys the embedder holds, which a guest kernel reaches only through
/// handles: the credential it acts under, the authority it acts for, and any
/// key it generates.
///
/// - A message, the guest kernel's own bytes, is concealed to any DID, and
///   the credential behind it reveals it.
/// - A key is entrusted to a custodian, a credential or an authority whose
///   key the embedder holds, and the custodian recovers it as a credential.
///   Its seed never reaches the guest kernel, so a custodian is a handle and
///   never a DID.
///
/// Concealing takes a context, which the embedder binds into the key it
/// conceals with: a secret reveals only in the context it was concealed in.
/// Entrusting takes none: the embedder entrusts every key in a context of its
/// own, which no secret can be concealed in, so `reveal` never opens a
/// custody.
interface credential {
  use types.{did, hash, error};

  /// What a credential signs. The embedder writes each kind's bytes itself,
  /// with the credential as its issuer, so a guest kernel cannot get one kind
  /// signed as another, or anything signed that is not one of these.
  variant payload {
    invocation(invocation),
    delegation(delegation),
    head(head),
    revision-record(revision-record),
  }

  /// A UCAN invocation.
  record invocation {
    audience: option<did>,
    subject: did,
    command: string,
    /// DAG-CBOR of the map of arguments.
    arguments: list<u8>,
    /// The CIDs of the delegations that prove it.
    proofs: list<list<u8>>,
    cause: option<list<u8>>,
    issued-at: option<u64>,
    expiration: option<u64>,
    /// DAG-CBOR of the map of metadata.
    meta: option<list<u8>>,
    nonce: list<u8>,
  }

  /// A UCAN delegation.
  record delegation {
    audience: did,
    /// None delegates for each subject the issuer can reach.
    subject: option<did>,
    command: string,
    /// DAG-CBOR of the list of predicates.
    policy: list<u8>,
    expiration: option<u64>,
    not-before: option<u64>,
    /// DAG-CBOR of the map of metadata.
    meta: option<list<u8>>,
    nonce: list<u8>,
  }

  /// The head of a branch of Dialog DB, signed under `dialog/head@1\n`.
  record head {
    branch: string,
    tree: hash,
    edition: u64,
    context: option<list<watermark>>,
  }

  /// What a head's context says of one origin.
  record watermark {
    origin: hash,
    edition: u64,
    count: u64,
  }

  /// A revision record of Dialog DB, signed under
  /// `dialog/revision-record@1\n`.
  record revision-record {
    /// DAG-CBOR of the record, without its issuer and its signature.
    body: list<u8>,
  }

  /// A message, concealed to a DID. The guest kernel stores it and hands it
  /// back to the credential behind that DID to reveal the message.
  type secret = list<u8>;

  /// A key, entrusted to a custodian. The guest kernel stores it and hands it
  /// back to the custodian to recover the key.
  type custody = list<u8>;

  /// Whom a key is entrusted to.
  variant custodian {
    credential(borrow<credential>),
    authority(borrow<authority>),
  }

  /// A new key, made and held by the embedder.
  generate: async func() -> result<credential, error>;
  /// A key from a seed the guest kernel holds. The guest kernel knows its
  /// seed, so the embedder refuses it as a custodian.
  %import: async func(seed: list<u8>) -> result<credential, error>;
  /// `message`, concealed to `to` in `context`.
  conceal: async func(to: did, context: list<u8>, message: list<u8>) -> result<secret, error>;

  /// A key the embedder holds.
  resource credential {
    did: func() -> did;
    /// `payload`, written and signed: the signature over its bytes.
    sign: async func(payload: payload) -> result<list<u8>, error>;
    /// The message `secret` conceals, if it is concealed to this credential
    /// in `context`.
    reveal: async func(context: list<u8>, secret: secret) -> result<list<u8>, error>;
    /// This key, entrusted to `custodian`. Denied for a key the embedder
    /// holds where nothing reads its seed, such as a session's key in a
    /// browser.
    entrust: async func(custodian: custodian) -> result<custody, error>;
    /// The key `custody` holds, if it is entrusted to this credential.
    recover: async func(custody: custody) -> result<credential, error>;
    /// The key this credential derives in `context` for `label`, held by the
    /// embedder too. The same credential derives the same key each time, as
    /// Dialog DB derives a peer's session key from the peer's.
    derive: async func(context: list<u8>, label: list<u8>) -> result<credential, error>;
  }

  /// The authority a worker acts for. A guest kernel holds a handle only,
  /// and never signs as it.
  resource authority {
    did: async func() -> result<did, error>;
    /// `secret`, concealed to this authority in `context`, concealed to `to`
    /// instead.
    confide: async func(context: list<u8>, secret: secret, to: borrow<authority>)
      -> result<secret, error>;
    /// The key `custody` holds, if it is entrusted to this authority.
    recover: async func(custody: custody) -> result<credential, error>;
  }
}
