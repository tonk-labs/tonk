package sapling:kernel@0.1.0;

/// The replicas of remote peers, which a worker reads through the daemon. A
/// worker has no socket of its own. See PDD007, "Network".
interface network {
  use types.{did, hash, route, edition, error};

  /// A replica of a subject on a remote peer. Read only. It reads no blob:
  /// a `read` of a layer of the device, with the size of the blob, fetches
  /// what the store lacks from the peers of the subject. See PDD013, "The
  /// Daemon Fetches".
  resource replica {
    peer: func() -> did;
    subject: func() -> did;
    get: async func(catalog: string, key: hash) -> result<option<list<u8>>, error>;
    resolve: async func(namespace: string, cell: string) -> result<option<edition>, error>;
    %list: async func(namespace: string) -> result<list<string>, error>;
  }

  /// Reach the replica of `subject` on `peer`. The subject must be the subject
  /// of this worker, or a layer that this worker has open, and the peer a
  /// device peer that the daemon verified for a member of that subject. The
  /// daemon ignores `routes`: it dials only the routes that it recorded for
  /// the peer, so a guest kernel can give an empty list. The next version of
  /// the world removes `routes`.
  open-remote: async func(peer: did, routes: list<route>, subject: did)
    -> result<replica, error>;
}
