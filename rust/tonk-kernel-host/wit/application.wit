package sapling:kernel@0.1.0;

/// The channel between a worker and its embedder, from the side of the
/// worker. See PDD009, "The Application Interface".
///
/// A message is bytes the two ends agree on, such as a signed UCAN
/// invocation the embedder delivers to its audience and the receipt it
/// answers with. WIT puts an interface in one direction only, so the call
/// that brings a message from the embedder is in the export `channel`.
interface application {
  use types.{error};

  /// Send a message to the embedder.
  send: async func(message: list<u8>) -> result<_, error>;
}

/// The calls of the channel that the embedder makes into a worker.
interface channel {
  use types.{error};

  /// A message from the embedder.
  receive: async func(message: list<u8>) -> result<_, error>;
}
