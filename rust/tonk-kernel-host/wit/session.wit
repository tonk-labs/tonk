package sapling:kernel@0.1.0;

interface session {
  use types.{ucan};
  use credential.{credential, authority};

  /// The standing of a worker: the key it acts under, the authority it acts
  /// for, and the delegations between them. The embedder makes it and hands
  /// it to the guest kernel at boot.
  resource session {
    /// The key this worker acts under.
    credential: func() -> credential;
    /// The authority this worker acts for.
    authority: func() -> authority;
    /// The delegations to `credential` this worker acts under.
    proofs: func() -> list<ucan>;
  }
}
