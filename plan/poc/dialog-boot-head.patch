diff --git a/rust/dialog-repository/src/repository/branch/push.rs b/rust/dialog-repository/src/repository/branch/push.rs
index 6b41385..38d3629 100644
--- a/rust/dialog-repository/src/repository/branch/push.rs
+++ b/rust/dialog-repository/src/repository/branch/push.rs
@@ -1311,6 +1311,96 @@ mod tests {
         Ok(())
     }
 
+    /// A boot statement set on a branch's head travels with the branch: the
+    /// commits made after carry it, a push publishes it on the upstream's
+    /// head, a branch that pulls adopts it, and one that pulls with work of
+    /// its own keeps it on the merge.
+    #[dialog_common::test]
+    async fn it_carries_a_boot_statement_through_commit_push_and_pull() -> Result<()> {
+        use dialog_capability::identity::Boot;
+
+        let (operator, profile) = test_session_with_peer().await;
+        let repo = test_repo(&operator, &profile).await;
+        let assert = |of: &str, name: &str| -> Result<Instruction> {
+            Ok(Instruction::Assert(Artifact {
+                the: "user/name".parse()?,
+                of: of.parse()?,
+                is: Value::String(name.to_string()),
+                cause: None,
+            }))
+        };
+
+        let main = repo.branch("main").open().perform(&operator).await?;
+        let feature = repo.branch("feature").open().perform(&operator).await?;
+        feature.set_upstream(&main).perform(&operator).await?;
+        feature
+            .commit(stream::iter(vec![assert("user:1", "Alice")?]))
+            .perform(&operator)
+            .await?;
+
+        // The statement is set on the head as it stands.
+        let boot = Boot {
+            v: 1,
+            src: "https://tonk.network/releases/stable/worker.js".into(),
+            pin: Some("https://tonk.network/releases/one/worker.js".into()),
+            seq: 1,
+            issuer: operator.did(),
+            signature: vec![1; 64],
+        };
+        let mut head = feature.revision().expect("feature has a head");
+        head.verify()?;
+        head.boot = Some(boot.clone());
+        feature.reset(head.clone()).perform(&operator).await?;
+        feature.revision().expect("feature has a head").verify()?;
+
+        // A commit after carries it, and a push publishes it.
+        feature
+            .commit(stream::iter(vec![assert("user:2", "Bob")?]))
+            .perform(&operator)
+            .await?;
+        let committed = feature.revision().expect("feature has a head");
+        assert_ne!(committed.tree, head.tree);
+        assert_eq!(
+            committed.boot,
+            Some(boot.clone()),
+            "a commit carries the statement"
+        );
+        feature.push().perform(&operator).await?;
+        let published = repo
+            .branch("main")
+            .load()
+            .perform(&operator)
+            .await?
+            .revision()
+            .expect("main has a head");
+        assert_eq!(published.boot, Some(boot.clone()), "a push publishes it");
+
+        // A branch with nothing of its own adopts it with the head.
+        let follower = repo.branch("follower").open().perform(&operator).await?;
+        follower.set_upstream(&main).perform(&operator).await?;
+        follower.pull().perform(&operator).await?;
+        assert_eq!(
+            follower.revision().expect("follower has a head").boot,
+            Some(boot.clone()),
+            "a pull adopts it"
+        );
+
+        // A branch with work of its own keeps it on the merge.
+        let worker = repo.branch("worker").open().perform(&operator).await?;
+        worker.set_upstream(&main).perform(&operator).await?;
+        worker
+            .commit(stream::iter(vec![assert("user:3", "Carol")?]))
+            .perform(&operator)
+            .await?;
+        assert_eq!(worker.revision().expect("worker has a head").boot, None);
+        worker.pull().perform(&operator).await?;
+        let merged = worker.revision().expect("worker has a head");
+        merged.verify()?;
+        assert_eq!(merged.boot, Some(boot), "a merge keeps it");
+
+        Ok(())
+    }
+
     /// Pushing a spilling value ships its block to the local upstream, a
     /// spilled value shared by many facts ships once, and a re-push with
     /// nothing new is a no-op (no re-upload).
