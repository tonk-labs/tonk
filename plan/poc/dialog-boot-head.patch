From d231e42a1929c342ed377dab9f665cdf84069d3a Mon Sep 17 00:00:00 2001
From: Irakli Gozalishvili <contact@gozala.io>
Date: Mon, 12 Oct 2026 22:33:32 -0700
Subject: [PATCH 1/2] feat(capability): a head carries a boot statement its
 signature does not cover

A branch's head may say what the branch is to be run with: a line of
releases and the one pinned from it. The statement is signed in its own
right and sits beside the head's signed fields, so a reader from before
decodes and verifies a head as it always did. A head minted on another
carries the statement forward and a merge keeps the later of two.
---
 .../src/identity/revision.rs                  | 252 ++++++++++++++++++
 .../src/repository/branch/pull.rs             |   1 +
 .../src/repository/branch/push.rs             |  90 +++++++
 .../src/repository/branch/reset.rs            |   1 +
 4 files changed, 344 insertions(+)

diff --git a/rust/dialog-capability/src/identity/revision.rs b/rust/dialog-capability/src/identity/revision.rs
index 4f7bcb0..6b5cd3d 100644
--- a/rust/dialog-capability/src/identity/revision.rs
+++ b/rust/dialog-capability/src/identity/revision.rs
@@ -65,6 +65,93 @@ impl From<TreeReference> for TreeHash {
     }
 }
 
+/// What a branch says it is to be run with: a line of releases, and the
+/// one release pinned from it.
+///
+/// A head carries the statement beside the fields it signs, not among them.
+/// The head's own signature does not cover it, so a reader that predates the
+/// field decodes and verifies a head exactly as it always did, and a writer
+/// that predates it mints heads without one. The statement is signed in its
+/// own right ([`Boot::payload`]) by whoever set it. This crate says that
+/// the signature is its issuer's; whether that issuer may say what a branch
+/// runs is for whoever acts on the statement to decide.
+///
+/// Statements are ordered by `seq`. A head minted on another carries its
+/// statement forward, and a merge keeps the later of its two parents', so
+/// one set once travels with the branch until a later one replaces it.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Boot {
+    /// The version of the host the release needs.
+    pub v: u64,
+    /// The line of releases the pin was taken from.
+    pub src: String,
+    /// The release pinned: the address `src` led to. `None` follows the
+    /// line.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub pin: Option<String>,
+    /// Which statement this is, counting up from the branch's first.
+    pub seq: u64,
+    /// DID of the key that made the statement.
+    pub issuer: Did,
+    /// The issuer's Ed25519 signature over [`Boot::payload`].
+    #[serde(default, with = "serde_bytes")]
+    pub signature: Vec<u8>,
+}
+
+impl Boot {
+    /// The canonical signing payload of this statement, for the branch it
+    /// is made about: every field except the signature. It opens with
+    /// [`BOOT_SIGNING_DOMAIN`], so that a signature over a statement is
+    /// never one over a head or a revision record, and names the branch,
+    /// so that a statement made about one branch is none about another.
+    ///
+    /// ```text
+    /// domain tag ("dialog/boot@1\n")
+    /// (length (8, big-endian) ++ UTF-8) for branch, issuer, src
+    /// 0x00, or 0x01 ++ length (8, big-endian) ++ UTF-8 of pin
+    /// v (8, big-endian)
+    /// seq (8, big-endian)
+    /// ```
+    pub fn payload(&self, branch: &Entity) -> Vec<u8> {
+        let mut bytes = BOOT_SIGNING_DOMAIN.to_vec();
+        for field in [branch.as_str(), self.issuer.as_str(), self.src.as_str()] {
+            bytes.extend_from_slice(&(field.len() as u64).to_be_bytes());
+            bytes.extend_from_slice(field.as_bytes());
+        }
+        match &self.pin {
+            None => bytes.push(0x00),
+            Some(pin) => {
+                bytes.push(0x01);
+                bytes.extend_from_slice(&(pin.len() as u64).to_be_bytes());
+                bytes.extend_from_slice(pin.as_bytes());
+            }
+        }
+        bytes.extend_from_slice(&self.v.to_be_bytes());
+        bytes.extend_from_slice(&self.seq.to_be_bytes());
+        bytes
+    }
+
+    /// Verify that the signature is the issuer's over [`Boot::payload`]
+    /// for `branch`.
+    pub fn verify(&self, branch: &Entity) -> Result<(), HistoryError> {
+        verify_issuer_signature(self.issuer.as_str(), &self.payload(branch), &self.signature)
+    }
+
+    /// The later of two statements a head could carry: the one with the
+    /// higher `seq`, and of two with the same, the one a head already has.
+    fn later(held: Option<&Boot>, other: Option<&Boot>) -> Option<Boot> {
+        match (held, other) {
+            (Some(held), Some(other)) if other.seq > held.seq => Some(other.clone()),
+            (Some(held), _) => Some(held.clone()),
+            (None, other) => other.cloned(),
+        }
+    }
+}
+
+/// The domain tag opening every boot statement's signing payload. See
+/// [`HEAD_SIGNING_DOMAIN`].
+pub const BOOT_SIGNING_DOMAIN: &[u8] = b"dialog/boot@1\n";
+
 /// A revision represents a concrete state of the repository at a point in time.
 ///
 /// Causal position is derived from the revision DAG per
@@ -133,6 +220,11 @@ pub struct Revision {
     /// root is only final at publish time) — see [`Revision::verify`].
     #[serde(default, with = "serde_bytes")]
     pub signature: Vec<u8>,
+
+    /// What the branch says it is to be run with, when it says. Not
+    /// covered by the head's signature: see [`Boot`].
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub boot: Option<Boot>,
 }
 
 impl Revision {
@@ -146,6 +238,7 @@ impl Revision {
             edition: Edition::GENESIS,
             context: None,
             signature: Vec::new(),
+            boot: None,
         }
     }
 
@@ -170,6 +263,7 @@ impl Revision {
             edition: self.edition.successor(),
             context: None,
             signature: Vec::new(),
+            boot: self.boot.clone(),
         }
     }
 
@@ -196,6 +290,7 @@ impl Revision {
             edition: self.edition.max(upstream.edition).successor(),
             context: None,
             signature: Vec::new(),
+            boot: Boot::later(self.boot.as_ref(), upstream.boot.as_ref()),
         }
     }
 
@@ -437,4 +532,161 @@ mod tests {
             "a hostile watermark entry must be refused despite the valid signature"
         );
     }
+
+    fn statement(issuer: &ed25519_dalek::SigningKey, branch: &Entity, seq: u64) -> Boot {
+        let mut boot = Boot {
+            v: 1,
+            src: "https://tonk.network/releases/stable/worker.js".into(),
+            pin: Some(format!(
+                "https://tonk.network/releases/release-{seq}/worker.js"
+            )),
+            seq,
+            issuer: did_of(issuer),
+            signature: Vec::new(),
+        };
+        boot.signature = issuer.sign(&boot.payload(branch)).to_bytes().to_vec();
+        boot
+    }
+
+    /// The head as a reader that predates the boot statement knows it.
+    #[derive(Debug, PartialEq, Serialize, Deserialize)]
+    struct HeadBefore {
+        branch: Entity,
+        issuer: Did,
+        tree: TreeReference,
+        edition: Edition,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        context: Option<Context>,
+        #[serde(default, with = "serde_bytes")]
+        signature: Vec<u8>,
+    }
+
+    impl HeadBefore {
+        fn verify(&self) -> Result<(), HistoryError> {
+            Revision {
+                branch: self.branch.clone(),
+                issuer: self.issuer.clone(),
+                tree: self.tree.clone(),
+                edition: self.edition,
+                context: self.context.clone(),
+                signature: self.signature.clone(),
+                boot: None,
+            }
+            .verify()
+        }
+    }
+
+    /// A statement is its issuer's, about one branch: another branch, a
+    /// changed pin, or another key's signature is refused.
+    #[test]
+    fn a_boot_statement_is_its_issuers_about_one_branch() {
+        let setter = key(3);
+        let branch: Entity = "branch:opaque".parse().unwrap();
+        let boot = statement(&setter, &branch, 1);
+        boot.verify(&branch).unwrap();
+
+        let elsewhere: Entity = "branch:another".parse().unwrap();
+        assert!(
+            boot.verify(&elsewhere).is_err(),
+            "made about another branch"
+        );
+
+        let mut repinned = boot.clone();
+        repinned.pin = Some("https://elsewhere.test/releases/other/worker.js".into());
+        assert!(repinned.verify(&branch).is_err(), "a pin it did not sign");
+
+        let mut following = boot.clone();
+        following.pin = None;
+        assert!(
+            following.verify(&branch).is_err(),
+            "following is not what it signed"
+        );
+
+        let mut reattributed = boot;
+        reattributed.issuer = did_of(&key(4));
+        assert!(reattributed.verify(&branch).is_err(), "another issuer");
+    }
+
+    /// A head's own signature does not cover its statement: a head verifies
+    /// with one, without one, and with another, and survives the wire with
+    /// it.
+    #[test]
+    fn a_head_carries_a_boot_statement_its_signature_does_not_cover() {
+        let issuer = key(1);
+        let head = signed_head(&issuer, |_| {});
+        let mut carrying = head.clone();
+        carrying.boot = Some(statement(&key(3), &head.branch, 1));
+        carrying.verify().unwrap();
+        assert_eq!(carrying.payload(), head.payload());
+
+        let bytes = serde_ipld_dagcbor::to_vec(&carrying).unwrap();
+        let read: Revision = serde_ipld_dagcbor::from_slice(&bytes).unwrap();
+        assert_eq!(read, carrying);
+        read.verify().unwrap();
+        read.boot.unwrap().verify(&head.branch).unwrap();
+    }
+
+    /// A reader that predates the statement reads a head that carries one
+    /// as the head it always read, and its signature verifies. What that
+    /// reader writes back has no statement.
+    #[test]
+    fn a_reader_from_before_ignores_a_boot_statement() {
+        let issuer = key(1);
+        let head = signed_head(&issuer, |_| {});
+        let mut carrying = head.clone();
+        carrying.boot = Some(statement(&key(3), &head.branch, 1));
+
+        let before: HeadBefore =
+            serde_ipld_dagcbor::from_slice(&serde_ipld_dagcbor::to_vec(&carrying).unwrap())
+                .unwrap();
+        before.verify().unwrap();
+        assert_eq!(
+            serde_ipld_dagcbor::to_vec(&before).unwrap(),
+            serde_ipld_dagcbor::to_vec(&head).unwrap(),
+            "it writes the head back without the statement"
+        );
+
+        // And a head from a writer that predates it reads as one with none.
+        let read: Revision =
+            serde_ipld_dagcbor::from_slice(&serde_ipld_dagcbor::to_vec(&before).unwrap()).unwrap();
+        assert_eq!(read, head);
+        assert_eq!(read.boot, None);
+    }
+
+    /// A head minted on another carries its statement forward, and a merge
+    /// keeps the later of its two parents'.
+    #[test]
+    fn a_boot_statement_travels_with_the_branch() {
+        let issuer = key(1);
+        let setter = key(3);
+        let branch: Entity = "branch:opaque".parse().unwrap();
+        let tree = TreeReference::from([8u8; 32]);
+        let first = statement(&setter, &branch, 1);
+        let second = statement(&setter, &branch, 2);
+
+        let mut head = Revision::new(tree.clone(), branch.clone(), did_of(&issuer));
+        assert_eq!(head.boot, None);
+        head.boot = Some(first.clone());
+
+        let next = head.advance(tree.clone(), branch.clone(), did_of(&issuer));
+        assert_eq!(next.boot, Some(first.clone()), "a commit carries it");
+
+        let mut theirs = head.advance(tree.clone(), branch.clone(), did_of(&key(2)));
+        theirs.boot = Some(second.clone());
+        for (ours, upstream) in [(&next, &theirs), (&theirs, &next)] {
+            let merged = ours.merge(upstream, tree.clone(), branch.clone(), did_of(&issuer));
+            assert_eq!(merged.boot, Some(second.clone()), "a merge keeps the later");
+        }
+
+        let mut bare = head.advance(tree.clone(), branch.clone(), did_of(&key(2)));
+        bare.boot = None;
+        for (ours, upstream) in [(&next, &bare), (&bare, &next)] {
+            let merged = ours.merge(upstream, tree.clone(), branch.clone(), did_of(&issuer));
+            assert_eq!(
+                merged.boot,
+                Some(first.clone()),
+                "a parent from a writer with none does not lose it"
+            );
+        }
+    }
 }
