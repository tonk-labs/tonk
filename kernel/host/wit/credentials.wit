package sapling:kernel@0.1.0;

/// The credentials of a layer: its keys at their addresses, and its secrets
/// for the sites it reaches. A guest kernel holds a credential as a resource;
/// its material stays in the embedder. See PDD015, "Credentials".
interface credentials {
  use types.{did, ucan, error};
  use storage.{layer};

  resource credential {
    /// The DID of this credential.
    did: func() -> did;
    /// Sign `payload`, which must be the payload of a UCAN invocation.
    sign-invocation: async func(payload: list<u8>, consent: option<ucan>)
      -> result<list<u8>, error>;
    /// Sign `payload`, which must be the payload of a UCAN delegation.
    sign-delegation: async func(payload: list<u8>, consent: option<ucan>)
      -> result<list<u8>, error>;
    /// Open a secret sealed to this credential in `context`.
    reveal: async func(context: string, sealed: list<u8>) -> result<list<u8>, error>;
    /// The key that this credential derives in `context` for `label`.
    derive: async func(context: string, label: list<u8>, consent: option<ucan>)
      -> result<credential, error>;
    /// This credential, sealed to `to` in `context`.
    seal: async func(to: did, context: string, consent: option<ucan>)
      -> result<list<u8>, error>;
  }

  load: async func(at: borrow<layer>, address: string) -> result<option<credential>, error>;
  generate: async func(at: borrow<layer>, address: string) -> result<credential, error>;
  adopt: async func(at: borrow<layer>, address: string, sealed: list<u8>,
                    by: borrow<credential>, context: string) -> result<credential, error>;
  forget: async func(at: borrow<layer>, address: string) -> result<_, error>;

  load-secret: async func(at: borrow<layer>, site: string) -> result<option<list<u8>>, error>;
  save-secret: async func(at: borrow<layer>, site: string, secret: list<u8>) -> result<_, error>;
  retract-secret: async func(at: borrow<layer>, site: string) -> result<_, error>;
}
