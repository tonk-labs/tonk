+    /// Private read-only handle for one subscription poll. Keep branch identity
+    /// and metadata, but detach the head and overlay from concurrent writers.
+    /// Content-addressed read caches remain shared. Never publish through it.
+    pub(crate) fn read_snapshot(&self) -> Result<Self, dialog_query::error::EvaluationError> {
+        for _ in 0..4 {
+            let edition = self.revision.edition();
+            let overlay = self.overlay.read_snapshot();
+            if self.revision.edition() != edition {
+                continue;
+            }
+            let mut pinned = self.clone();
+            pinned.revision = self.reference.revision();
+            if let Some(edition) = edition {
+                pinned.revision.reset(edition);
+            }
+            pinned.overlay = overlay;
+            return Ok(pinned);
+        }
+        Err(dialog_query::error::EvaluationError::Store(
+            "branch changed while capturing subscription read state".into(),
+        ))
+    }
