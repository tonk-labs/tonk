+        fn capture(store: &Ephemeral, cow: bool) -> Ephemeral {
+            if cow {
+                store.read_snapshot()
+            } else {
+                Ephemeral {
+                    state: Arc::new(RwLock::new(Arc::new((**store.state.read()).clone()))),
+                }
+            }
