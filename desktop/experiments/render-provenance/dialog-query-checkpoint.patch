+        fn write(store: &Ephemeral, value: String) {
+            let mut changes = Changes::new();
+            changes.associate_unique(
+                "test/counter".parse().unwrap(),
+                "id:counter".parse().unwrap(),
+                Value::String(value),
+            );
+            store.apply(changes).unwrap();
+        }
+        for count in [0, 100, 1_000, 10_000] {
+            let store = Ephemeral::new();
+            for i in 0..count {
+                store
+                    .assert(Claim(fact(&format!("id:item-{i}"), "test/value", "value")))
+                    .unwrap();
+            }
+            // Fixed-size fact set and full bounded log before every sample.
+            for i in 0..1100 {
+                write(&store, format!("warmup-{i}"));
+            }
+            for writes in [false, true] {
+                for sample in 0..8 {
+                    // Alternate order to expose drift; same contents and operations.
+                    for cow in if sample % 2 == 0 {
+                        [false, true]
+                    } else {
+                        [true, false]
+                    } {
+                        let start = Clock::now();
+                        for iteration in 0..20 {
+                            let snapshot = capture(&store, cow);
+                            if writes {
+                                write(&store, format!("{sample}-{cow}-{iteration}"));
+                            }
+                            black_box(snapshot.revision());
+                            black_box(snapshot);
+                        }
+                        println!(
+                            "snapshot-cost,{count},{writes},{sample},{cow},{}",
+                            start.elapsed().as_nanos() / 20
+                        );
+                    }
+                }
+            }
+        }
