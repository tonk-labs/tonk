+        /// Test-only adapter over real renderer state, for the static inline
+        /// light-DOM subset in this fixture. Not a public render receipt API.
+        fn capture_nested_barrier(root: &Element) -> Option<usize> {
+            use crate::render_barrier::{Barrier, Checkpoint, Ticket};
+            fn visit(b: &mut Barrier, id: Ticket, el: &Element) -> Option<()> {
+                let facts = registry::display_facts(el)?;
+                if !el.is_connected()
+                    || !facts.setup_complete
+                    || el.get_attribute("data-state").as_deref() != Some("ready")
+                    || facts.timeline.is_held()
+                    || el.query_selector("tonk-portal").ok()?.is_some()
+                {
+                    return None;
+                }
+                // This fixture uses directly addressed models, three subscribed inputs,
+                // no fallback query, no commands and no arbitrary custom components.
+                for tag in ["model", "view", "entity"] {
+                    let checkpoint = facts.query_checkpoints.get(tag)?;
+                    let input = b.input(id, None)?;
+                    b.acknowledge(
+                        id,
+                        input,
+                        Checkpoint {
+                            scope: format!("{}:{tag}", el.get_attribute("model")?),
+                            durable: checkpoint
+                                .get("revision")
+                                .filter(|v| !v.is_null())
+                                .map(ToString::to_string),
+                            overlay: checkpoint.to_string(),
+                        },
+                    );
+                }
+                let children = el.query_selector_all("tonk-display").ok()?;
+                for index in 0..children.length() {
+                    let child: Element = children.item(index)?.dyn_into().ok()?;
+                    let nearest = child.parent_element()?.closest("tonk-display").ok()??;
+                    if nearest.is_same_node(Some(el.as_ref())) {
+                        let child_id = b.child(id)?;
+                        visit(b, child_id, &child)?;
+                    }
+                }
+                b.seal(id);
+                Some(())
+            }
+            let mut b = Barrier::new();
+            let id = b.root;
+            visit(&mut b, id, root)?;
+            Some(b.receipt()?.inputs.len())
+        }
+
+        fn deliver_to(consumer: &Element, method: &str, tag: &str, payload: &JsValue) {
+            let opts = Object::new();
+            Reflect::set(&opts, &"tag".into(), &tag.into()).unwrap();
+            let callback: Function = Reflect::get(consumer, &method.into())
+                .unwrap()
+                .dyn_into()
+                .unwrap();
+            callback.call2(consumer, payload, &opts).unwrap();
+        }
+
