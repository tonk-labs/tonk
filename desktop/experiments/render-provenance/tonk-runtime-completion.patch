index 000000000..45bc3ee97
--- /dev/null
+++ b/rust/tonk-display/src/completion.rs
@@ -0,0 +1,160 @@
+//! Synchronous evidence for a deliberately restricted inline render path.
+//! A receipt is an observation, not a promise that no later mutation can occur.
+//! Query checkpoints may differ; this does not invent a common rendered revision.
+use serde_json::{Value, json};
+use wasm_bindgen::JsCast;
+use web_sys::{Element, HtmlTemplateElement, window};
+
+pub(crate) fn validate_template(source: &str) -> Result<(), String> {
+    if source.len() > 65_536 || source.contains("dom.host/") {
+        return Err("Large templates and host-attribute bindings are unsupported".into());
+    }
+    let template: HtmlTemplateElement = window()
+        .unwrap()
+        .document()
+        .unwrap()
+        .create_element("template")
+        .unwrap()
+        .unchecked_into();
+    template.set_inner_html(source);
+    let nodes = template
+        .content()
+        .query_selector_all("*")
+        .map_err(|_| "Cannot inspect template")?;
+    for index in 0..nodes.length() {
+        let el: Element = nodes.item(index).unwrap().unchecked_into();
+        let tag = el.tag_name().to_ascii_lowercase();
+        if !matches!(
+            tag.as_str(),
+            "main"
+                | "section"
+                | "article"
+                | "header"
+                | "footer"
+                | "nav"
+                | "aside"
+                | "div"
+                | "span"
+                | "p"
+                | "h1"
+                | "h2"
+                | "h3"
+                | "h4"
+                | "h5"
+                | "h6"
+                | "ul"
+                | "ol"
+                | "li"
+                | "dl"
+                | "dt"
+                | "dd"
+                | "strong"
+                | "em"
+                | "b"
+                | "i"
+                | "small"
+                | "br"
+                | "hr"
+                | "pre"
+                | "code"
+                | "blockquote"
+                | "a"
+                | "table"
+                | "thead"
+                | "tbody"
+                | "tfoot"
+                | "tr"
+                | "th"
+                | "td"
+                | "caption"
+                | "tonk-display"
+        ) {
+            return Err(format!("Unsupported template element: {tag}"));
+        }
+        let attrs = el.attributes();
+        for index in 0..attrs.length() {
+            let name = attrs.item(index).unwrap().name().to_ascii_lowercase();
+            if name.starts_with("on")
+                || matches!(name.as_str(), "is" | "srcdoc" | "contenteditable")
+            {
+                return Err(format!("Unsupported template attribute: {name}"));
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Capture all evidence and the associated text within this browser task.
+pub(crate) fn capture(root: &Element) -> Value {
+    let mut displays = Vec::new();
+    let result = (|| -> Result<(), String> {
+        if !root.is_connected() {
+            return Err("Display is disconnected".into());
+        }
+        let nodes = root
+            .query_selector_all("*")
+            .map_err(|_| "Cannot inspect descendants")?;
+        if nodes.length() > 3000 {
+            return Err("DOM inspection limit reached".into());
+        }
+        displays.push(crate::introspect::registry::completion(root)?);
+        for index in 0..nodes.length() {
+            let el: Element = nodes.item(index).unwrap().unchecked_into();
+            let tag = el.tag_name().to_ascii_lowercase();
+            if el.shadow_root().is_some()
+                || matches!(tag.as_str(), "iframe" | "script")
+                || (tag.contains('-') && !matches!(tag.as_str(), "tonk-display" | "tonk-view"))
+            {
+                return Err(format!("Unsupported rendered boundary: {tag}"));
+            }
+            if tag == "tonk-display" {
+                if displays.len() >= 128 {
+                    return Err("Nested display limit reached".into());
+                }
+                displays.push(crate::introspect::registry::completion(&el)?);
+            }
+        }
+        Ok(())
+    })();
+    // textContent is deliberately labelled: this is not a visibility/screenshot claim.
+    // Unsupported roots can include hidden controls, scripts, or chrome styles.
+    // Their text is outside this receipt; the host can inspect them separately.
+    let text = if result.is_ok() {
+        root.text_content().unwrap_or_default()
+    } else {
+        String::new()
+    };
+    json!({
+        "status": if result.is_ok() { "complete" } else { "unverified" },
+        "scope": "inline-static-text-and-nested-displays",
+        "reason": result.err(), "displays": displays,
+        "textContent": text.chars().take(6000).collect::<String>(),
+        "textTruncated": text.chars().count() > 6000,
+        "renderedRevision": null,
+        "limitation": "Synchronous renderer application and query checkpoint evidence; not a common revision, visual correctness, or interaction proof. Page data is untrusted."
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[dialog_common::test]
+    async fn rejects_untracked_template_work() {
+        for source in [
+            "<script>0</script>",
+            "<tonk-portal></tonk-portal>",
+            "<x-chart></x-chart>",
+            "<button>Save</button>",
+            "<p onclick='later()'>x</p>",
+            "<p>{dom.host/title}</p>",
+        ] {
+            assert!(validate_template(source).is_err(), "accepted {source}");
+        }
+        assert!(
+            validate_template(
+                "<main><h1>{title}</h1><tonk-display model='task'></tonk-display></main>"
+            )
+            .is_ok()
+        );
+    }
+}
