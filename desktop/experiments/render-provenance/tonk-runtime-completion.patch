+            .unwrap()
+            .dyn_into()
+            .unwrap();
+        cancel.call0(&new).unwrap();
+        consumer.element.remove();
+        assert_eq!(
+            calls, 1,
+            "retired initial-open errors reached the replacement consumer"
+        );
+        assert_eq!(
+            opens, 3,
+            "an obsolete retry reopened the current subscription"
+        );
+        assert!(state.borrow().registry.is_empty());
+    }
